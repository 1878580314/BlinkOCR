{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BlinkOCR",
  "version": "0.1.0",
  "identifier": "app.blinkocr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1427",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BlinkOCR",
        "width": 760,
        "height": 760,
        "minWidth": 360,
        "minHeight": 360,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1427 ws://127.0.0.1:1427"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility"
  }
}
